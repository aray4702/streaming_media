name bufferbloat
describe 1 Mbps uplink behind a 2 s deep router buffer
duration 40s
at 0s capacity=1000kbps delay=20ms queue=2s
expect cc.queue_p95_ms < 100
expect video.freeze_count == 0
# Was < 200 (neteq v1: 149-168 ms on seeds 1-10). With NetEq the default (#62), seeds 1-10 give 180-224 ms (200.4 on
# seed 1); libwebrtc M157 gives 150-207 ms (174.3 on seed 1, 206.5 on seed 4) and fails < 200 on seed 4. The jitter
# buffer delay p95 matches libwebrtc (ours 101-144, libwebrtc 90-140). Bound per the Owner's rule on PR #226: just
# above ours on seed 1, never above libwebrtc's worst seed in 1-10. Needs the Owner's sign-off (program.md 0.2).
# PR for #375 (Opus size model calibrated to libopus; the start probe moves; program.md 0.2, needs-human): was < 205. Ours 211 on seed 1;
# libwebrtc 204.3 on seed 1, worst of seeds 1-10 205.9, on #324's compare-webrtc (6a7d615, scaling on). Seed-1 outlier;
# mean in band (ours 202.2 / libwebrtc 184.7, band 18.2). Owner's outlier clause: 10 % above ours.
expect audio.mouth_to_ear_p95_ms < 233
