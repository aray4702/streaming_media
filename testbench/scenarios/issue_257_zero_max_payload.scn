name issue_257_zero_max_payload
describe A video stream configured with max_payload_size 0 must not hang: the sender clamps it to libwebrtc's 100-byte minimum packet and the call goes on
duration 20s
# Issue 257: max_payload_size 0 made every padding packet carry 0 bytes, so RtpSender::GeneratePadding
# allocated packets until bad_alloc. The parser on the base commit rejects the directive, and the
# library there hangs on the value.
video_max_payload 0
at 0s capacity=2500kbps delay=25ms queue=300ms
expect audio.interruptions == 0
expect video.frames_rendered > 0
