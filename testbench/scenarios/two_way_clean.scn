name two_way_clean
describe Two-way audio call (user <-> AI) on a clean 2.5 Mbps link each way, 25 ms one-way: both directions flawless (#746)
duration 30s
call two-way
video off
at 0s capacity=2500kbps delay=25ms queue=300ms
reverse at 0s capacity=2500kbps delay=25ms queue=300ms
# The audio lines of clean_link, for each direction.
expect up.audio.concealed_pct < 1
expect up.audio.interruptions == 0
expect down.audio.concealed_pct < 1
expect down.audio.interruptions == 0
