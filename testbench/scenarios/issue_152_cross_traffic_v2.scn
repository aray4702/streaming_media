name issue_152_cross_traffic_v2
describe cross_traffic with every v2 switch on, traced next to libwebrtc (yardstick for issue #152)
# Same link as cross_traffic. Queue p95 is 84 ms against libwebrtc's 263 (issue #152); the expect lines are cross_traffic's.
cc v2
pacer v2
tcc v2
rtx v2
rtcp v2
keyframe v2
allocator v2
packetization v2
audio v2
duration 40s
at 0s  capacity=3000kbps delay=25ms queue=300ms
at 10s cross=1500kbps
at 25s cross=0kbps
expect video.freeze_count == 0
expect cc.queue_p95_ms < 250
expect cc.unsettled == 0
