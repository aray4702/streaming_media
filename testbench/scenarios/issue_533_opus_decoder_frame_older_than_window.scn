name issue_533_opus_decoder_frame_older_than_window
describe Audio call over a link whose jitter is a 2 s standard deviation: some packets arrive more than 5 s late
# Issue #533: OpusAudioDecoder::Insert (testbench/opus_decoder.h) stored a frame
# older than all 250 remembered ones at the front of its map, trimmed the map
# back to 250 (erasing that frame) and then returned the erased frame's samples:
# a heap-use-after-free. The native build reads the freed block silently, so the
# base commit is built with ASan+UBSan, which abort on it. The unit test
# OpusDecoder.FrameOlderThanTheWindowIsDecodedNotKept pins the decoder itself.
# fix-record-base-cmake: -DSM_SANITIZE=ON
duration 20s
video off
at 0s jitter=2s
expect audio.concealed_pct < 100
# Issue #783: NetEq keeps a packet more than 5 s late and plays it as a future packet
# (expand, then merge back to it), as DiscardOldPackets' 5 s horizon and DecisionLogic do.
# libwebrtc conceals 24.9-32.5% on seeds 1-10 (28.3 on seed 1); before #783 we concealed 35.0.
expect audio.concealed_pct < 33
