name mesh_3_home_broadband
describe A 3-party mesh call on home broadband (10 Mbit/s down, 2 Mbit/s up): each participant sends audio and 640x360 video (at most 800 kbps per peer, as mesh apps cap it) to each of the 2 others over its one uplink, where the 2 sessions' controllers compete (#1072)
duration 30s
call mesh 3
video_size 640x360
video_max 800kbps
# Each participant's access link: the uplink (`at`) and the downlink (`reverse at`). i -> j crosses i's uplink, then j's downlink.
at 0s capacity=2Mbps delay=15ms queue=300ms
reverse at 0s capacity=10Mbps delay=15ms queue=300ms
# Every pair: program.md 6.3's rows (no audio interruptions, no freeze over 1 s, mouth-to-ear under 400 ms).
expect p1_to_p2.audio.interruptions == 0
expect p1_to_p2.video.longest_freeze_ms < 1000
expect p1_to_p2.audio.mouth_to_ear_p95_ms < 400
expect p1_to_p3.audio.interruptions == 0
expect p1_to_p3.video.longest_freeze_ms < 1000
expect p1_to_p3.audio.mouth_to_ear_p95_ms < 400
expect p2_to_p1.audio.interruptions == 0
expect p2_to_p1.video.longest_freeze_ms < 1000
expect p2_to_p1.audio.mouth_to_ear_p95_ms < 400
expect p2_to_p3.audio.interruptions == 0
expect p2_to_p3.video.longest_freeze_ms < 1000
expect p2_to_p3.audio.mouth_to_ear_p95_ms < 400
expect p3_to_p1.audio.interruptions == 0
expect p3_to_p1.video.longest_freeze_ms < 1000
expect p3_to_p1.audio.mouth_to_ear_p95_ms < 400
expect p3_to_p2.audio.interruptions == 0
expect p3_to_p2.video.longest_freeze_ms < 1000
expect p3_to_p2.audio.mouth_to_ear_p95_ms < 400
# The upload cost: 2 peers' streams on one uplink, against a 1:1 call's (1.91-1.96 for 3, 2.03-2.06 for 4 over seeds 1-5).
expect mesh.upload_cost_ratio > 1.8
