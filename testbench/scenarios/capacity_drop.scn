name capacity_drop
describe Capacity drops from 2.5 Mbps to 500 kbps at 10 s and recovers at 25 s
duration 40s
at 0s  capacity=2500kbps delay=30ms queue=400ms
at 10s capacity=500kbps
at 25s capacity=2500kbps
# Known gap: the target does not ramp back up after the capacity returns at 25 s.
expect audio.interruptions <= 1
expect video.longest_freeze_ms < 4000
