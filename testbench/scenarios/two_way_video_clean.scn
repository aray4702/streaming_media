name two_way_video_clean
describe Two-way call with audio and video both ways (user <-> AI) on a clean 2.5 Mbps link each way, 25 ms one-way (#747)
duration 30s
call two-way
at 0s capacity=2500kbps delay=25ms queue=300ms
reverse at 0s capacity=2500kbps delay=25ms queue=300ms
# program.md 6.3 for each direction: no audio interruptions or freezes > 1 s (sev:2), and video never stops (sev:1).
expect up.audio.interruptions == 0
expect down.audio.interruptions == 0
expect up.video.longest_freeze_ms < 1000
expect down.video.longest_freeze_ms < 1000
expect up.video.pause_count == 0
expect down.video.pause_count == 0
