name issue_21_capacity_drop_repair
describe Capacity drops 5x at 10 s: repair traffic must follow the target down (issue #21; bounds tightened after #56, main: loss 4.6, overhead 10.0 on seed 1)
duration 40s
at 0s  capacity=2500kbps delay=30ms queue=400ms
at 10s capacity=500kbps
at 25s capacity=2500kbps
# libwebrtc (sm_compare, mean of 3 seeds): loss 1.4 %, repair overhead 2.9 %.
expect net.loss_pct < 4
expect repair.overhead_pct < 8
expect audio.interruptions <= 1
