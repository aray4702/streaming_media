name issue_76_rtx_v2_keyframe_flush
describe pacer v2 + rtx v2 + keyframe v2 together under loss and a capacity drop (#76 group 2): end-to-end smoke test of the combination
# Keyframes flush queued resends under pacer v2. This scenario only checks the combination stays healthy;
# the flushed-resend wiring (RtpSender::OnPacketDropped) is pinned by the unit test
# SendSideController.FlushedResendCanBeRequestedAgainUnderPacerV2AndRtxV2.
compare_seeds 80
duration 40s
at 0s  capacity=2500kbps delay=30ms queue=400ms loss=2%
at 10s capacity=500kbps
at 25s capacity=2500kbps
# seed-1 outlier; mean in band (ours 3163 / libwebrtc 2928). Harness change #516 (#507); Coordinator decision A, 2026-10-28.
expect video.freeze_total_ms < 5000
expect video.residual_loss_pct < 1
