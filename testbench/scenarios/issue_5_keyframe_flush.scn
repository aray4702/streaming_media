name issue_5_keyframe_flush
describe libwebrtc's pacer keyframe flush (issue #5, PR 3): after a capacity drop the keyframe leaves ahead of the stale queue instead of behind it
duration 40s
seed 2
# PacingController::EnqueuePacket discards the stream's queued packets when a keyframe starts.
# Total freeze time on a drop to 500 kbps, base -> flush, seeds 1-3: 3966 -> 2157, 3197 -> 2007,
# 4250 -> 2227 ms; seeds 4, 5: 3680 -> 1859, 4006 -> 2402 (longest 1589 at most) (libwebrtc `capacity_drop`: 2355-2538 ms).
at 0s  capacity=2500kbps delay=30ms queue=400ms
at 10s capacity=500kbps
at 25s capacity=2500kbps
expect video.freeze_total_ms < 3000
# PR #336 (session started before the first frame, refs #331; program.md 0.2, needs-human): was < 1700. Ours 2223 on seed 2;
# libwebrtc 2258 on seed 2 (mean of seeds 2-11 2090) on main's compare-webrtc after #340, which also misses < 1700.
expect video.longest_freeze_ms < 2240
