# libsrtp for DTLS-SRTP (milestone 3, C5 part 1, #995): the SRTP library libwebrtc M157 builds. M157's DEPS pins
# Chromium's libsrtp mirror at cd5d177b, which is upstream v2.8.0 plus a Windows-only printf fix; this fetches
# upstream v2.8.0 (24b3bf8f). It is built as Chromium's third_party/libsrtp/BUILD.gn builds it: with the OpenSSL
# crypto backend (OPENSSL, GCM, so AES-GCM is available) on BoringSSL, linking sm_boringssl_crypto.
#
#   sm_add_libsrtp()   defines the target sm_libsrtp (needs sm_add_boringssl() first)
#
# Set SM_LIBSRTP_SOURCE_DIR to use a checkout you already have. Only sm::tls links it.
include_guard(GLOBAL)
enable_language(C)

set(SM_LIBSRTP_REV 24b3bf8f19b6f5ab4cd2bcceb4f4064efca86fd5)  # tag v2.8.0
set(SM_LIBSRTP_REPO https://github.com/cisco/libsrtp.git)
set(SM_LIBSRTP_SOURCE_DIR "" CACHE PATH "libsrtp source at ${SM_LIBSRTP_REV} (fetched into the build tree when empty)")

function(sm_add_libsrtp)
  if(TARGET sm_libsrtp)
    return()
  endif()
  if(SM_LIBSRTP_SOURCE_DIR)
    set(dir ${SM_LIBSRTP_SOURCE_DIR})
  else()
    set(dir ${CMAKE_BINARY_DIR}/_deps/libsrtp-${SM_LIBSRTP_REV})
  endif()
  if(NOT EXISTS ${dir}/include/srtp.h)
    find_package(Git REQUIRED)
    message(STATUS "Fetching libsrtp ${SM_LIBSRTP_REV}")
    file(REMOVE_RECURSE ${dir})
    file(MAKE_DIRECTORY ${dir})
    execute_process(COMMAND ${GIT_EXECUTABLE} init -q WORKING_DIRECTORY ${dir} RESULT_VARIABLE rc)
    foreach(attempt 1 2 3 4 5)
      execute_process(COMMAND ${GIT_EXECUTABLE} fetch -q --depth 1 ${SM_LIBSRTP_REPO} ${SM_LIBSRTP_REV}
                      WORKING_DIRECTORY ${dir} RESULT_VARIABLE rc)
      if(rc EQUAL 0)
        break()
      endif()
      message(STATUS "libsrtp fetch attempt ${attempt} failed")
      execute_process(COMMAND ${CMAKE_COMMAND} -E sleep 10)
    endforeach()
    if(rc EQUAL 0)
      execute_process(COMMAND ${GIT_EXECUTABLE} -c advice.detachedHead=false checkout -q FETCH_HEAD
                      WORKING_DIRECTORY ${dir} RESULT_VARIABLE rc)
    endif()
    if(NOT rc EQUAL 0 OR NOT EXISTS ${dir}/include/srtp.h)
      message(FATAL_ERROR "Could not fetch libsrtp ${SM_LIBSRTP_REV} from ${SM_LIBSRTP_REPO}; "
                          "set SM_LIBSRTP_SOURCE_DIR to a checkout of that revision")
    endif()
  endif()

  # config.h as libsrtp's config_in_cmake.h would produce it with ENABLE_OPENSSL on a POSIX host.
  set(cfg ${CMAKE_BINARY_DIR}/_deps/libsrtp-config)
  include(CheckTypeSize)
  include(TestBigEndian)
  test_big_endian(SM_LIBSRTP_BIG_ENDIAN)
  set(config "/* Generated by cmake/SmLibsrtp.cmake (libsrtp's config_in_cmake.h with ENABLE_OPENSSL). */\n")
  string(APPEND config "#define PACKAGE_VERSION \"2.8.0\"\n#define PACKAGE_STRING \"libsrtp2 2.8.0\"\n")
  string(APPEND config "#define OPENSSL 1\n#define GCM 1\n#define CPU_CISC 1\n")
  if(SM_LIBSRTP_BIG_ENDIAN)
    string(APPEND config "#define WORDS_BIGENDIAN 1\n")
  endif()
  foreach(h ARPA_INET_H INTTYPES_H NETINET_IN_H STDINT_H STDLIB_H SYS_SOCKET_H SYS_TYPES_H UNISTD_H)
    string(APPEND config "#define HAVE_${h} 1\n")
  endforeach()
  foreach(t UINT8_T UINT16_T UINT32_T UINT64_T INT32_T INET_PTON INET_ATON SIGACTION USLEEP INLINE)
    string(APPEND config "#define HAVE_${t} 1\n")
  endforeach()
  string(APPEND config "#define SIZEOF_UNSIGNED_LONG ${CMAKE_SIZEOF_VOID_P}\n#define SIZEOF_UNSIGNED_LONG_LONG 8\n")
  set(old "")
  if(EXISTS ${cfg}/config.h)
    file(READ ${cfg}/config.h old)
  endif()
  if(NOT old STREQUAL config)
    file(WRITE ${cfg}/config.h "${config}")
  endif()

  add_library(sm_libsrtp STATIC
    ${dir}/srtp/srtp.c
    ${dir}/crypto/cipher/cipher.c
    ${dir}/crypto/cipher/cipher_test_cases.c
    ${dir}/crypto/cipher/null_cipher.c
    ${dir}/crypto/cipher/aes_icm_ossl.c
    ${dir}/crypto/cipher/aes_gcm_ossl.c
    ${dir}/crypto/hash/auth.c
    ${dir}/crypto/hash/auth_test_cases.c
    ${dir}/crypto/hash/null_auth.c
    ${dir}/crypto/hash/hmac_ossl.c
    ${dir}/crypto/kernel/alloc.c
    ${dir}/crypto/kernel/crypto_kernel.c
    ${dir}/crypto/kernel/err.c
    ${dir}/crypto/kernel/key.c
    ${dir}/crypto/math/datatypes.c
    ${dir}/crypto/replay/rdb.c
    ${dir}/crypto/replay/rdbx.c)
  set_target_properties(sm_libsrtp PROPERTIES POSITION_INDEPENDENT_CODE ON C_STANDARD 99)
  target_compile_definitions(sm_libsrtp PRIVATE HAVE_CONFIG_H)
  target_include_directories(sm_libsrtp PRIVATE ${cfg})
  target_include_directories(sm_libsrtp SYSTEM PUBLIC ${dir}/include ${dir}/crypto/include)
  target_link_libraries(sm_libsrtp PUBLIC sm_boringssl_crypto)
endfunction()
