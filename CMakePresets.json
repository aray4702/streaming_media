{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "base", "hidden": true,
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    },
    {"name": "native", "inherits": "base", "displayName": "Host (desktop/server), Release, tests + benchmarks"},
    {"name": "native-asan", "inherits": "base", "displayName": "Host, Debug, ASan + UBSan",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "SM_SANITIZE": "ON", "SM_BUILD_BENCH": "OFF"}},
    {"name": "embedded", "inherits": "base", "displayName": "Size-optimized, no exceptions/RTTI, metrics and events compiled out",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "MinSizeRel", "SM_NO_EXCEPTIONS": "ON", "SM_ENABLE_METRICS": "OFF",
                        "SM_ENABLE_EVENTS": "OFF", "SM_BUILD_TESTS": "OFF", "SM_BUILD_BENCH": "OFF", "SM_BUILD_EXAMPLES": "OFF"}},
    {"name": "wasm", "inherits": "base", "displayName": "WebAssembly (set EMSCRIPTEN_ROOT; tests run with Node)",
     "toolchainFile": "$env{EMSCRIPTEN_ROOT}/cmake/Modules/Platform/Emscripten.cmake"},
    {"name": "ios", "inherits": "base", "displayName": "iOS arm64 (device), library only",
     "generator": "Xcode",
     "cacheVariables": {"CMAKE_SYSTEM_NAME": "iOS", "CMAKE_OSX_ARCHITECTURES": "arm64",
                        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0", "SM_BUILD_TESTS": "OFF", "SM_BUILD_BENCH": "OFF",
                        "SM_BUILD_EXAMPLES": "OFF"}},
    {"name": "ios-simulator", "inherits": "ios", "displayName": "iOS simulator (arm64)",
     "cacheVariables": {"CMAKE_OSX_SYSROOT": "iphonesimulator"}},
    {"name": "android-arm64", "inherits": "base", "displayName": "Android arm64-v8a (API 24+)",
     "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
     "cacheVariables": {"ANDROID_ABI": "arm64-v8a", "ANDROID_PLATFORM": "android-24", "ANDROID_STL": "c++_static"}},
    {"name": "android-armv7", "inherits": "android-arm64", "displayName": "Android armeabi-v7a (wearables, older phones)",
     "cacheVariables": {"ANDROID_ABI": "armeabi-v7a"}},
    {"name": "linux-aarch64", "inherits": "base", "displayName": "Embedded Linux aarch64 (robots, Jetson, Raspberry Pi 4/5)",
     "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake"},
    {"name": "linux-armv7", "inherits": "embedded", "displayName": "Embedded Linux ARMv7 hard-float (wearables, cameras)",
     "toolchainFile": "${sourceDir}/cmake/toolchains/arm-linux-gnueabihf.cmake"}
  ],
  "buildPresets": [
    {"name": "native", "configurePreset": "native"},
    {"name": "native-asan", "configurePreset": "native-asan"},
    {"name": "embedded", "configurePreset": "embedded"},
    {"name": "wasm", "configurePreset": "wasm"},
    {"name": "android-arm64", "configurePreset": "android-arm64"},
    {"name": "linux-aarch64", "configurePreset": "linux-aarch64"}
  ],
  "testPresets": [
    {"name": "native", "configurePreset": "native", "output": {"outputOnFailure": true}},
    {"name": "native-asan", "configurePreset": "native-asan", "output": {"outputOnFailure": true}},
    {"name": "wasm", "configurePreset": "wasm", "output": {"outputOnFailure": true}}
  ]
}
